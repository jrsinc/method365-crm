# Name shown in the UI, page titles and emails.
NEXT_PUBLIC_APP_NAME=method365 CRM

# SQLite file location (created automatically, seeded with demo data on first start).
DATABASE_PATH=./data/crm.db

# Password given to the demo users when the database is first created.
SEED_PASSWORD=

# Set to 0 to hide the demo-account box on the sign-in page.
SHOW_DEMO_LOGINS=1

# Only for running a production build over plain http (e.g. on localhost).
# Leave unset behind HTTPS so session cookies are marked Secure.
# INSECURE_COOKIES=1

# Outlook / Microsoft 365 (Entra ID app registration). Leave empty to disable.
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3001/api/outlook/callback

# ---- Outgoing email (sign-in codes, review notices) ----
# Mailbox the CRM sends from.
MAIL_SENDER=
# Name shown as the sender.
MAIL_FROM_NAME=method365 CRM
# Send with the mailbox password over SMTP. Microsoft 365: smtp.office365.com / 587 (turn on "Authenticated SMTP").
# method365sign.com (webhostbox.net): sh00007.webhostbox.net / 465.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Sign-in name for the mailbox (usually the same as MAIL_SENDER).
SMTP_USER=
# The mailbox password. Leave empty to use the Graph Mail.Send method instead.
SMTP_PASS=

